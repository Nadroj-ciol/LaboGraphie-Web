# Variables d'environnement — LaboGraphie Web
# Copiez ce fichier en `.env.local` et remplissez les valeurs avec vos identifiants Supabase
# Retrouvez ces valeurs dans : Supabase Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://VOTRE_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIC
